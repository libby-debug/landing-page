# ABA Mastered production environment template
# Copy these keys into Vercel Project Settings > Environment Variables.
# Placeholder values only. Do not commit real secrets.

# Supabase client-side configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server/admin configuration
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe client/server configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Site URL used for Stripe Checkout redirects and auth redirects
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Optional Stripe price overrides. Leave unset to use the production price IDs in code.
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_subscription
STRIPE_3_MONTH_PRICE_ID=price_your_3_month_subscription
STRIPE_6_MONTH_PRICE_ID=price_your_6_month_subscription
